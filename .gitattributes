# ==========================================
# IntelliBitz Global .gitattributes
# ==========================================

# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files that require LF
*.sh text eol=lf
*.bash text eol=lf
*.exp text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.adoc text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
gradlew text eol=lf

# Windows scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files - prevent Git from modifying line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.swf binary
*.pdf binary
*.jar binary
*.war binary
*.ear binary
*.rar binary
*.zip binary
*.tar.gz binary
*.tgz binary
*.db binary
*.sqlite binary
*.so binary
*.dll binary
*.exe binary
